# Flutter/Dart build artifacts — regenerated by `flutter pub get` / `flutter build`.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/

# Never commit signing secrets — see android/.gitignore for the Android-side
# rules (key.properties, *.jks, *.keystore).

# Loose local test artifacts (phone screenshots, ad-hoc APK copies, sample
# report exports) that land in the project root during manual testing —
# not part of the source tree.
/*.apk
/Screenshot_*.jpg
/Screenshot_*.png
/friendshipmania_report_*.png

# Firebase client config (per-project, kept out of the public repo like friend_zone does)
android/app/google-services.json
firebase-debug.log
firestore-debug.log

# Intermediate files for assets/icon/build_store_graphics.sh
assets/icon/.build/

# Intermediate files and pub state for marketing/launch
marketing/launch/.build/
marketing/launch/qrgen/.dart_tool/
marketing/launch/qrgen/pubspec.lock
