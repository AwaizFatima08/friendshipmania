# Flutter/Dart build artifacts — regenerated by `flutter pub get` / `flutter build`.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/

# Never commit signing secrets — see android/.gitignore for the Android-side
# rules (key.properties, *.jks, *.keystore).

# Loose local test artifacts (phone screenshots, ad-hoc APK copies, sample
# report exports) that land in the project root during manual testing —
# not part of the source tree.
/*.apk
/Screenshot_*.jpg
/Screenshot_*.png
/friendshipmania_report_*.png
